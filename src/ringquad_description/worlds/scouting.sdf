          <geometry><box><size>0.023 0.025 0.002</size></box></geometry>
          <material><ambient>0.200 0.120 0.050 1</ambient><diffuse>0.200 0.120 0.050 1</diffuse></material>
        </visual>
        <visual name="spot1">
          <pose>-0.161 0.120 0.0041 0 0 1.410</pose>
          <geometry><box><size>0.018 0.018 0.002</size></box></geometry>
          <material><ambient>0.300 0.200 0.070 1</ambient><diffuse>0.300 0.200 0.070 1</diffuse></material>
        </visual>
        <visual name="spot2">
          <pose>0.141 -0.127 0.0042 0 0 1.304</pose>
