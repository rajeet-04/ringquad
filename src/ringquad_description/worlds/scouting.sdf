          <material><ambient>0.620 0.550 0.100 1</ambient><diffuse>0.620 0.550 0.100 1</diffuse></material>
        </visual>
        <visual name="halo8">
          <pose>-0.126 -0.020 0.0016 0 0 0.904</pose>
          <geometry><box><size>0.218 0.109 0.002</size></box></geometry>
          <material><ambient>0.580 0.500 0.120 1</ambient><diffuse>0.580 0.500 0.120 1</diffuse></material>
        </visual>
        <visual name="core0">
          <pose>-0.027 -0.013 0.0030 0 0 2.930</pose>
          <geometry><box><size>0.095 0.108 0.002</size></box></geometry>
          <material><ambient>0.190 0.120 0.050 1</ambient><diffuse>0.190 0.120 0.050 1</diffuse></material>
        </visual>
        <visual name="core1">
          <pose>0.021 0.006 0.0031 0 0 2.749</pose>
          <geometry><box><size>0.089 0.095 0.002</size></box></geometry>
          <material><ambient>0.220 0.140 0.055 1</ambient><diffuse>0.220 0.140 0.055 1</diffuse></material>
        </visual>
        <visual name="core2">
          <pose>-0.000 0.024 0.0032 0 0 0.216</pose>
