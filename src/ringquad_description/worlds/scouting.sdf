<?xml version="1.0"?>
<!--
  Scouting scene for the inspection loop: flat crop-green ground, one dark brown patch at
  (0.10, 0.00) that the baseline detector picks up, rendering Sensors system for the camera.
  Same physics and plugins as demo.sdf. Use with: demo.launch.py mission:=false camera:=true world:=scouting
-->
<sdf version="1.9">
  <world name="scouting">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <!-- Bullet Featherstone is selected below; DART remains in the diagnostic world. -->
      <dart><collision_detector>bullet</collision_detector></dart>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"><engine><filename>gz-physics-ringquad-bullet-plugin</filename></engine></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.25 0.55 0.2 1</ambient><diffuse>0.25 0.55 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the anomaly: visual only, ragged blight-like patch (yellow-green halo, dark core, scattered lesions) -->
    <model name="canopy_patch">
      <static>true</static>
      <pose>0.1 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="halo0">
          <pose>-0.025 0.049 0.0000 0 0 0.227</pose>
          <geometry><box><size>0.174 0.129 0.002</size></box></geometry>
          <material><ambient>0.550 0.600 0.120 1</ambient><diffuse>0.550 0.600 0.120 1</diffuse></material>
        </visual>
        <visual name="halo1">
          <pose>0.085 0.032 0.0002 0 0 0.270</pose>
          <geometry><box><size>0.162 0.119 0.002</size></box></geometry>
          <material><ambient>0.550 0.600 0.120 1</ambient><diffuse>0.550 0.600 0.120 1</diffuse></material>
        </visual>
        <visual name="halo2">
          <pose>-0.044 -0.014 0.0004 0 0 2.975</pose>
          <geometry><box><size>0.183 0.147 0.002</size></box></geometry>
          <material><ambient>0.550 0.600 0.120 1</ambient><diffuse>0.550 0.600 0.120 1</diffuse></material>
        </visual>
        <visual name="halo3">
          <pose>0.091 0.037 0.0006 0 0 3.065</pose>
          <geometry><box><size>0.125 0.169 0.002</size></box></geometry>
          <material><ambient>0.550 0.600 0.120 1</ambient><diffuse>0.550 0.600 0.120 1</diffuse></material>
        </visual>
        <visual name="halo4">
          <pose>-0.013 0.053 0.0008 0 0 1.793</pose>
          <geometry><box><size>0.176 0.155 0.002</size></box></geometry>
          <material><ambient>0.550 0.600 0.120 1</ambient><diffuse>0.550 0.600 0.120 1</diffuse></material>
        </visual>
        <visual name="halo5">
          <pose>0.077 0.059 0.0010 0 0 1.169</pose>
          <geometry><box><size>0.175 0.105 0.002</size></box></geometry>
          <material><ambient>0.620 0.550 0.100 1</ambient><diffuse>0.620 0.550 0.100 1</diffuse></material>
        </visual>
        <visual name="halo6">
          <pose>0.056 0.022 0.0012 0 0 2.440</pose>
          <geometry><box><size>0.167 0.174 0.002</size></box></geometry>
          <material><ambient>0.580 0.500 0.120 1</ambient><diffuse>0.580 0.500 0.120 1</diffuse></material>
        </visual>
        <visual name="halo7">
          <pose>-0.042 0.050 0.0014 0 0 2.195</pose>
