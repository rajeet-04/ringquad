          <material><ambient>0.250 0.150 0.060 1</ambient><diffuse>0.250 0.150 0.060 1</diffuse></material>
        </visual>
        <visual name="core3">
          <pose>0.013 -0.035 0.0033 0 0 2.203</pose>
          <geometry><box><size>0.109 0.110 0.002</size></box></geometry>
          <material><ambient>0.250 0.150 0.060 1</ambient><diffuse>0.250 0.150 0.060 1</diffuse></material>
        </visual>
        <visual name="core4">
          <pose>-0.017 -0.009 0.0034 0 0 2.100</pose>
          <geometry><box><size>0.071 0.083 0.002</size></box></geometry>
          <material><ambient>0.190 0.120 0.050 1</ambient><diffuse>0.190 0.120 0.050 1</diffuse></material>
        </visual>
        <visual name="spot0">
