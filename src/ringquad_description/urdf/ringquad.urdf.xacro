<?xml version="1.0"?>
<!--
  Morphing ring-propeller quad (DESIGN.md v0.3, medium size).
  Frames: x forward, y left, z up. Hinges at the body corners, at CoM height.

  Fold: every hinge turns 0 (flight, arms in X) to 90 deg (ground, rings upright without camber). Left hinges use axis -x, right hinges +x, so the
  same positive command folds all four.

  Ring spin on the ground: left ring axis points left, right ring axis points right.
  Driving forward = positive joint velocity on left rings, negative on right rings.
-->
<robot name="ringquad" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    tread: rubber (spec), omni (passive rollers around every rim: low sideways friction), or
    mixed (omni front rings, rubber rear rings: pivots about the rear axle like a differential-drive
    robot on casters; the only option that both turns and holds a line with realistic motors)
  -->
  <xacro:arg name="tread" default="rubber"/>
  <xacro:arg name="drivetrain" default="separate"/>
  <xacro:property name="separate_drive" value="${'$(arg drivetrain)' == 'separate'}"/>
  <xacro:arg name="steering" default="front"/>
  <xacro:arg name="self_collision" default="true"/>
  <xacro:arg name="tread_collision" default="crowned"/>
  <gazebo><self_collide>$(arg self_collision)</self_collide></gazebo>

  <xacro:arg name="fold_ground_deg" default="90"/>
  <xacro:arg name="lock_break_torque" default="8.0"/>
  <xacro:arg name="servo_torque" default="1.0"/>
  <xacro:arg name="servo_speed" default="1.5"/>
  <xacro:arg name="friction_scale" default="1.0"/>
  <xacro:arg name="knuckle_mass" default="0.04"/>
  <xacro:arg name="ring_offset" default="0.1"/>
  <xacro:arg name="steering_limit_deg" default="25"/>
  <!-- ===== parameters (metres, kg) ===== -->
  <xacro:property name="body_l" value="0.16"/>
  <xacro:property name="body_w" value="0.16"/>
  <xacro:property name="body_h" value="0.08"/>
  <xacro:property name="body_m" value="${1.102 if separate_drive else 1.0}"/>

  <xacro:property name="arm_len" value="0.12"/>      <!-- hinge to ring centre -->
  <xacro:property name="arm_r" value="0.008"/>
  <xacro:property name="arm_m" value="${0.28 if separate_drive else 0.11}"/>        <!-- arm + motor -->
  <xacro:property name="ring_offset" value="$(arg ring_offset)"/> <!-- ring plane offset along motor axis -->

  <xacro:property name="ring_r_out" value="0.135"/>
  <xacro:property name="ring_r_in" value="0.12"/>
  <xacro:property name="ring_w" value="0.03"/>
  <xacro:property name="ring_m" value="${.072 if separate_drive else .06}"/>
  <xacro:property name="ring_segments" value="24"/>
  <xacro:property name="blade_pitch" value="${radians(15)}"/>

  <xacro:property name="fold_max" value="${radians(float('$(arg fold_ground_deg)'))}"/>
  <!-- sideways tread friction per axle. Rubber 0.6 when all four rings must scrub to turn (see
       the tyre friction note); real rubber 1.0 in mixed, where the rear rings never scrub; omni ~0.05 -->
  <xacro:property name="tread" value="$(arg tread)"/>
  <xacro:property name="front_lateral_mu" value="${1.0 if tread == 'rubber' else 0.05}"/>
  <xacro:property name="rear_lateral_mu" value="${1.0 if tread == 'rubber' else (0.05 if tread == 'omni' else 1.0)}"/>

  <!-- realistic motors: see the spin joint and ringquad_control/params.py -->
  <xacro:property name="motor_torque" value="0.33"/>
  <xacro:property name="rim_damping" value="1.79e-4"/>

  <!-- ===== materials ===== -->
  <material name="body_grey"><color rgba="0.25 0.27 0.30 1"/></material>
  <material name="arm_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="tread"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="blade_front"><color rgba="0.95 0.45 0.10 1"/></material>
  <material name="blade_rear"><color rgba="0.20 0.55 0.95 1"/></material>

  <!-- ===== ring tread: segments around a circle (recursive) ===== -->
  <xacro:macro name="ring_segment" params="i">
    <xacro:if value="${i > 0}">
      <xacro:property name="a" value="${2 * pi * i / ring_segments}"/>
      <visual>
        <origin xyz="${(ring_r_in + ring_r_out) / 2 * cos(a)} ${(ring_r_in + ring_r_out) / 2 * sin(a)} 0"
                rpy="0 0 ${a}"/>
        <geometry>
          <box size="${ring_r_out - ring_r_in} ${2 * pi * ring_r_out / ring_segments * 1.05} ${ring_w}"/>
        </geometry>
        <material name="tread"/>
      </visual>
      <xacro:ring_segment i="${i - 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="prop_visuals">
      <!-- hub -->
      <visual>
        <geometry><cylinder radius="0.02" length="0.012"/></geometry>
        <material name="arm_black"/>
      </visual>
      <!-- four pitched blades (spokes) from hub to rim -->
      <xacro:property name="blade_len" value="${(.115 if separate_drive else ring_r_in) - 0.02}"/>
      <xacro:property name="blade_mid" value="${0.02 + blade_len / 2}"/>
      <visual>
        <origin xyz="${blade_mid} 0 0" rpy="${blade_pitch} 0 0"/>
        <geometry><box size="${blade_len} 0.025 0.003"/></geometry>
        <material name="${blade_mat}"/>
      </visual>
      <visual>
        <origin xyz="0 ${blade_mid} 0" rpy="${blade_pitch} 0 ${pi / 2}"/>
        <geometry><box size="${blade_len} 0.025 0.003"/></geometry>
        <material name="${blade_mat}"/>
      </visual>
      <visual>
        <origin xyz="${-blade_mid} 0 0" rpy="${blade_pitch} 0 ${pi}"/>
        <geometry><box size="${blade_len} 0.025 0.003"/></geometry>
        <material name="${blade_mat}"/>
      </visual>
      <visual>
        <origin xyz="0 ${-blade_mid} 0" rpy="${blade_pitch} 0 ${-pi / 2}"/>
        <geometry><box size="${blade_len} 0.025 0.003"/></geometry>
        <material name="${blade_mat}"/>
      </visual>
  </xacro:macro>

  <!-- Wheel supported by three rollers on a stationary rear carrier; no spokes cross the propeller plane. -->
  <xacro:macro name="carrier_parts" params="cx cy cz base_angle:=0">
    <xacro:if value="${separate_drive}">
      <visual><origin xyz="${cx+.090*cos(base_angle)} ${cy+.090*sin(base_angle)} ${cz-.0636}"/>
        <geometry><cylinder radius=".010" length=".0432"/></geometry><material name="arm_black"/></visual>
      <collision><origin xyz="${cx+.090*cos(base_angle)} ${cy+.090*sin(base_angle)} ${cz-.0636}"/>
        <geometry><cylinder radius=".010" length=".0432"/></geometry></collision>
      <xacro:carrier_spoke a="${base_angle}" cx="${cx}" cy="${cy}" cz="${cz}"/>
      <xacro:carrier_spoke a="${base_angle+2*pi/3}" cx="${cx}" cy="${cy}" cz="${cz}"/>
      <xacro:carrier_spoke a="${base_angle+4*pi/3}" cx="${cx}" cy="${cy}" cz="${cz}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="carrier_spoke" params="a cx cy cz">
    <visual><origin xyz="${cx+.0475*cos(a)} ${cy+.0475*sin(a)} ${cz-.030}" rpy="0 0 ${a}"/>
      <geometry><box size=".095 .016 .018"/></geometry><material name="arm_black"/></visual>
    <collision><origin xyz="${cx+.0475*cos(a)} ${cy+.0475*sin(a)} ${cz-.030}" rpy="0 0 ${a}"/>
      <geometry><box size=".095 .016 .018"/></geometry></collision>
    <visual><origin xyz="${cx+.090*cos(a)} ${cy+.090*sin(a)} ${cz-.0225}"/>
      <geometry><cylinder radius=".013" length=".010"/></geometry><material name="arm_black"/></visual>
  </xacro:macro>

  <xacro:macro name="rear_contacts" params="i count folder prefix">
    <xacro:if value="${i &lt; count}">
      <collision><geometry><mesh filename="package://ringquad_description/meshes/${folder}/${prefix}_${i}.stl"/></geometry></collision>
      <xacro:rear_contacts i="${i+1}" count="${count}" folder="${folder}" prefix="${prefix}"/>
    </xacro:if>
  </xacro:macro>

  <!-- ===== one arm + ring ===== -->
  <xacro:macro name="corner" params="name x y yaw axis_x blade_mat lateral_mu">
    <joint name="hinge_${name}" type="revolute">
      <parent link="chassis"/>
      <child link="arm_${name}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="${axis_x} 0 0"/>
      <limit lower="0" upper="${fold_max}" effort="10.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <link name="arm_${name}">
      <visual>
        <origin xyz="${arm_len / 2 * cos(yaw)} ${arm_len / 2 * sin(yaw)} 0" rpy="0 ${pi / 2} ${yaw}"/>
        <geometry><cylinder radius="${arm_r}" length="${arm_len}"/></geometry>
        <material name="arm_black"/>
      </visual>
      <xacro:unless value="${'$(arg steering)' == 'front' and name in ['fl','fr']}">
        <xacro:carrier_parts cx="${arm_len*cos(yaw)}" cy="${arm_len*sin(yaw)}" cz="${ring_offset}" base_angle="${pi if name in ['rl','rr'] else 0}"/>
      </xacro:unless>
      <!-- motor and drive package represented at the arm tip -->
      <visual>
        <origin xyz="${arm_len * cos(yaw)} ${arm_len * sin(yaw)} ${ring_offset / 2}"/>
        <geometry><cylinder radius="0.014" length="${ring_offset}"/></geometry>
        <material name="arm_black"/>
      </visual>
      <inertial>
        <origin xyz="${0.75 * arm_len * cos(yaw)} ${0.75 * arm_len * sin(yaw)} 0"/>
        <mass value="${arm_m}"/>
        <inertia ixx="1.5e-4" iyy="1.5e-4" izz="2.5e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <xacro:property name="steered" value="${'$(arg steering)' == 'front' and name in ['fl', 'fr']}"/>
    <xacro:if value="${steered}">
      <joint name="steer_${name}" type="revolute">
        <parent link="arm_${name}"/><child link="knuckle_${name}"/>
        <origin xyz="${arm_len * cos(yaw)} ${arm_len * sin(yaw)} ${ring_offset}"/>
        <!-- Vertical at the 90-degree ground stop, zero angle locked for flight. -->
        <axis xyz="0 ${axis_x} 0"/>
        <limit lower="${-radians(float('$(arg steering_limit_deg)')) / sin(radians(float('$(arg fold_ground_deg)'))) - .005}" upper="${radians(float('$(arg steering_limit_deg)')) / sin(radians(float('$(arg fold_ground_deg)'))) + .005}" effort="${float('$(arg servo_torque)')+float('$(arg lock_break_torque)')}" velocity="$(arg servo_speed)"/>
        <dynamics damping="0.05"/>
      </joint>
      <link name="knuckle_${name}">
        <xacro:carrier_parts cx="0" cy="0" cz="0"/>
        <inertial><mass value="$(arg knuckle_mass)"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
      </link>

    </xacro:if>
    <joint name="${'wheel_' if separate_drive else 'spin_'}${name}" type="continuous">
      <xacro:if value="${steered}"><parent link="knuckle_${name}"/><origin xyz="0 0 0"/></xacro:if>
      <xacro:unless value="${steered}"><parent link="arm_${name}"/><origin xyz="${arm_len * cos(yaw)} ${arm_len * sin(yaw)} ${ring_offset}"/></xacro:unless>
      <child link="ring_${name}"/>
      <axis xyz="0 0 1"/>
      <!--
        Realistic motor (ringquad_control/params.py). The physics engine enforces the motor
        model's speed with at most this torque, so spin-up is limited by the ring's inertia:
        0.4 Nm peak motor torque minus the ~0.07 Nm blade drag at hover (which the motor model
        applies to the body, not to this joint). Damping stands in for the rim's skin drag,
        linearised at hover: 0.092 Nm / 514 rad/s.
      -->
      <limit effort="${motor_torque}" velocity="${5.6 if separate_drive else 1000}"/>
      <dynamics damping="${0.002 if separate_drive else rim_damping}"/>
    </joint>

    <link name="ring_${name}">
      <xacro:if value="${'$(arg tread_collision)' == 'crowned'}"><visual><geometry><mesh filename="package://ringquad_description/meshes/crowned_rim.stl"/></geometry><material name="tread"/></visual></xacro:if>
      <xacro:unless value="${'$(arg tread_collision)' == 'crowned'}"><xacro:ring_segment i="${ring_segments}"/></xacro:unless>
      <xacro:unless value="${separate_drive}"><xacro:prop_visuals/></xacro:unless>
      <!-- Convex rounded tread contact; outer dimensions match the ring. -->
      <collision><geometry>
        <xacro:if value="${'$(arg tread_collision)' == 'cylinder'}"><cylinder radius="${ring_r_out}" length="${ring_w}"/></xacro:if>
        <xacro:if value="${'$(arg tread_collision)' == 'crowned'}"><mesh filename="package://ringquad_description/meshes/crowned_tread_hull.stl"/></xacro:if>
        <xacro:if value="${'$(arg tread_collision)' == 'rounded'}"><mesh filename="package://ringquad_description/meshes/rounded_tread.stl"/></xacro:if>
      </geometry></collision>
      <xacro:if value="${'$(arg tread_collision)' == 'crowned'}">
        <xacro:rear_contacts i="0" count="16" folder="rear_race_segments" prefix="race"/>
        <xacro:rear_contacts i="0" count="12" folder="rear_tab_segments" prefix="tab"/>
      </xacro:if>
      <inertial>
        <mass value="${ring_m}"/>
        <xacro:property name="rim_ixx" value="${ring_m * (.1275**2/2 + 3*.0075**2/8 + .015**2/4) if '$(arg tread_collision)' == 'crowned' else ring_m / 12 * (3 * (ring_r_in**2 + ring_r_out**2) + ring_w**2)}"/>
        <xacro:property name="rim_izz" value="${ring_m * (.1275**2 + 3*.0075**2/4) if '$(arg tread_collision)' == 'crowned' else ring_m / 2 * (ring_r_in**2 + ring_r_out**2)}"/>
        <!-- annulus: Izz = m/2 (ri^2 + ro^2), Ixx = m/12 (3 (ri^2 + ro^2) + w^2) -->
        <inertia ixx="${rim_ixx}"
                 iyy="${rim_ixx}"
                 izz="${rim_izz}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <xacro:if value="${separate_drive}">
      <joint name="spin_${name}" type="continuous">
        <xacro:if value="${steered}"><parent link="knuckle_${name}"/><origin xyz="0 0 0"/></xacro:if>
        <xacro:unless value="${steered}"><parent link="arm_${name}"/><origin xyz="${arm_len*cos(yaw)} ${arm_len*sin(yaw)} ${ring_offset}"/></xacro:unless>
        <child link="prop_${name}"/><axis xyz="0 0 1"/>
        <limit effort="${motor_torque}" velocity="1090"/>
      </joint>
      <link name="prop_${name}">
        <xacro:prop_visuals/>
        <inertial><mass value="0.015"/><inertia ixx="5.5e-5" iyy="5.5e-5" izz="1.1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
      </link>
    </xacro:if>

    <!--
      Tyre friction. DART limits friction per direction (a pyramid, not a circle), so a tyre
      sliding forward still grips fully sideways. With wheelbase/track 1.09 that jams
      turns on the spot (sideways grip x half-wheelbase beats drive x half-track) until it
      breaks loose in jerks. Lower sideways friction (along the ring axis, fdir1) restores
      the turning a real tyre's friction circle gives; it must stay below 0.92 x forward.
    -->
    <gazebo reference="ring_${name}">
      <mu1>${lateral_mu * float('$(arg friction_scale)')}</mu1>
      <mu2>$(arg friction_scale)</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>

  <!-- ===== body ===== -->
  <link name="base_link"/>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${body_m}"/>
      <inertia ixx="${body_m / 12 * (body_w**2 + body_h**2)}"
               iyy="${body_m / 12 * (body_l**2 + body_h**2)}"
               izz="${body_m / 12 * (body_l**2 + body_w**2)}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- orange blades at the front, blue at the rear -->
  <xacro:corner lateral_mu="${front_lateral_mu}" name="fl" x="${body_l / 2}"  y="${body_w / 2}"  yaw="${radians(45)}"   axis_x="-1" blade_mat="blade_front"/>
  <xacro:corner lateral_mu="${front_lateral_mu}" name="fr" x="${body_l / 2}"  y="${-body_w / 2}" yaw="${radians(-45)}"  axis_x="1"  blade_mat="blade_front"/>
  <xacro:corner lateral_mu="${rear_lateral_mu}" name="rl" x="${-body_l / 2}" y="${body_w / 2}"  yaw="${radians(135)}"  axis_x="-1" blade_mat="blade_rear"/>
  <xacro:corner lateral_mu="${rear_lateral_mu}" name="rr" x="${-body_l / 2}" y="${-body_w / 2}" yaw="${radians(-135)}" axis_x="1"  blade_mat="blade_rear"/>

  <gazebo><plugin filename="libringquad_steering_lock.so" name="ringquad::SteeringLock"><servo_torque>$(arg servo_torque)</servo_torque><servo_speed>$(arg servo_speed)</servo_speed><lock_break_torque>$(arg lock_break_torque)</lock_break_torque><joint_limit>${radians(float('$(arg steering_limit_deg)')) / sin(radians(float('$(arg fold_ground_deg)'))) + .005}</joint_limit></plugin></gazebo>
  <!-- ===== Gazebo Harmonic plugins ===== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <!-- Native pose/velocity odometry is published by the finite actuator system. -->
  </gazebo>

  <gazebo reference="chassis">
    <!-- noise: gyro 0.05 rad/s, accel 0.3 m/s^2 (sensor noise plus typical airframe vibration) -->
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <topic>/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.3</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!--
    One motor per ring, used in both modes (all four read /ringquad/motor_speed,
    index = number). Flight: thrust = k w^2 along the ring axis, drag torque about it.
    Ground: the same commanded speed spins the ring as a wheel; negative commands reverse it.
    Joint velocity = turning direction (ccw +1, cw -1) x command. Positive command = upward thrust.
    Values must match ringquad_control/params.py.
  -->
  <xacro:macro name="rotor" params="name number direction">
    <gazebo>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>ringquad</robotNamespace>
        <jointName>spin_${name}</jointName>
        <linkName>${'prop_' if separate_drive else 'ring_'}${name}</linkName>
        <turningDirection>${direction}</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1090.0</maxRotVelocity>
        <motorConstant>${8.4e-6 if separate_drive else 1.56e-5}</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>motor_speed</commandSubTopic>
        <actuator_number>${number}</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Finite wheel torque is applied by SteeringLock; coast throughout folding. -->




  <!-- Shared-drive historical model; separate drives use finite propeller torque. -->
  <xacro:unless value="${separate_drive}">
  <xacro:rotor name="fl" number="0" direction="ccw"/>
  <xacro:rotor name="fr" number="1" direction="cw"/>
  <xacro:rotor name="rl" number="2" direction="cw"/>
  <xacro:rotor name="rr" number="3" direction="ccw"/>
  </xacro:unless>
</robot>
